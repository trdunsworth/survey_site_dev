# Server
PORT=3001
API_BASE=
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
API_BODY_LIMIT=64kb
API_RATE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT_MAX=300

# Database engine: "duckdb" (local) or "sqlite" (fallback)
DB_ENGINE=duckdb

# Local DuckDB (transactional store)
DUCKDB_PATH=server/survey_responses.db

# Analytics DuckDB (separate file for analytics tables)
DUCKDB_ANALYTICS_PATH=server/survey_analytics.duckdb

# MotherDuck (optional — cloud analytics target)
# MOTHERDUCK_DB=my_database
# MOTHERDUCK_TOKEN=your_token_here
# ANALYTICS_REQUIRE_MOTHERDUCK=false

# DuckDB extensions
DUCKDB_LOAD_QUACK=true

# Data retention
INCOMPLETE_PURGE_DAYS=7
COMPLETED_ARCHIVE_DAYS=365
RETENTION_SWEEP_INTERVAL_MS=21600000
